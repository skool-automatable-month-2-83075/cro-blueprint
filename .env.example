# Copy to .env and fill in. NEVER commit .env. Each command asks for what it needs, the first time.

# PostHog - the ONE key you paste. Settings > Personal API keys > Create, scopes "All access" (phx_...).
# `python3 code/posthog_setup.py --connect --key phx_...` fills every other PostHog line below from it.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=            # filled by --connect: the number in every PostHog URL
POSTHOG_API_HOST=https://us.posthog.com    # filled by --connect: an EU account gets https://eu.posthog.com

# The project key the browser uses (phc_...). Filled by --connect, here and in website/.env.local.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com    # EU: https://eu.i.posthog.com


# Your site and business
SITE_BASE_URL=                 # https://example.com - recordings are limited to this domain; --connect fills it from website/lib/site.config.ts
BUSINESS_NAME=
BUSINESS_PHONE=                # the one real number, no pools
COUNTRY=
MAIN_CITY=                     # the H1 fallback city, or none
LEAD_WEBHOOK_URL=              # GHL: Automation > new workflow > trigger "Inbound Webhook"
GHL_CALENDAR_URL=              # the booking calendar embed for /thank-you, or none

# Call tracking - GoHighLevel posts to /api/call when a call reaches the page's number.
# The commands generate this secret and hand you the full webhook URL to paste into GHL.
CALL_WEBHOOK_SECRET=

# Which tracking number belongs to which split-test arm, so a call counts for the right page.
# "<digits>=<flag>:<variant>,..." - written by /split-test when two numbers are given. Empty = one
# number on both pages, and calls are the page's total rather than a per-arm number.
CALL_NUMBER_MAP=

# Optional
DEV_PORT=3000                  # the dev server port code/dev_server.py starts and checks; change it when 3000 is busy
PAGESPEED_API_KEY=             # Lighthouse LCP/INP/CLS in /audit (console.cloud.google.com > PageSpeed Insights API)
UNSPLASH_ACCESS_KEY=           # placeholder photography for empty slots (code/fetch_photos.py)
APIFY_TOKEN=                   # /personas research: Reddit, reviews and rivals (apify.com > Settings > API and integrations); without it, web search does a smaller sample
