# Copy to .env.local. /analytics fills these in.
# Project API key: PostHog > Settings > Project > Project API key (starts with phc_). Safe to ship to the browser.
NEXT_PUBLIC_POSTHOG_KEY=
# US cloud by default. EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# GoHighLevel posts a webhook here when a call reaches the page's tracking number.
# /split-test and /audit generate this and give you the full URL to paste into GHL.
CALL_WEBHOOK_SECRET=

# Which tracking number belongs to which split-test arm, so a call counts for the right page.
# "<digits>=<flag>:<variant>,..." - written by /split-test when two numbers are given. Empty = one
# number on both pages, and calls are the page's total rather than a per-arm number.
CALL_NUMBER_MAP=
